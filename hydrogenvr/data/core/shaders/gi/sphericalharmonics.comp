#version 420 core
#extension GL_ARB_compute_shader : enable
#extension GL_ARB_shader_image_load_store : enable
#extension GL_ARB_shader_image_size : enable
#extension GL_ARB_shader_storage_buffer_object : enable
#extension GL_NV_shader_atomic_float : enable

layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

layout(rgba32f, binding = 0) uniform readonly imageCube environmentMap;
layout(std430, binding = 1) buffer SHCoeffs
{
	vec4 shCoeffs[];
};

const float PI = 3.14159265359;

vec3 computeDirectionFromTexel(ivec3 texelCoords, int cubemapSize)
{
	// Determine which face of the cubemap the texel is on
	int face = texelCoords.z;

	// Normalize texel coordinates to [-1, 1]
	vec2 coord = (vec2(texelCoords.xy) / float(cubemapSize - 1)) * 2.0 - 1.0;

	// Compute direction based on the face
	vec3 direction;
	switch(face)
	{
		case 0:
			direction = vec3(1.0, -coord.y, -coord.x);
			break; // Positive X
		case 1:
			direction = vec3(-1.0, -coord.y, coord.x);
			break; // Negative X
		case 2:
			direction = vec3(coord.x, 1.0, coord.y);
			break; // Positive Y
		case 3:
			direction = vec3(coord.x, -1.0, -coord.y);
			break; // Negative Y
		case 4:
			direction = vec3(coord.x, -coord.y, 1.0);
			break; // Positive Z
		case 5:
			direction = vec3(-coord.x, -coord.y, -1.0);
			break; // Negative Z
		default:
			break;
	}

	return normalize(direction);
}

// Ramamoorthi, R., & Hanrahan, P. (2001, August).
// An efficient representation for irradiance environment maps.
// In Proceedings of the 28th annual conference on Computer graphics and
// interactive techniques (pp. 497-500).
void ProjectOntoSH(in vec3 n, in vec3 color, out vec3 sh[9])
{
	float x = n.x, y = n.y, z = n.z;
	float x2 = x*x, y2 = y*y, z2 = z*z;
	float x3 = x2*x, y3 = y2*y, z3 = z2*z;
	float z4 = z2*z2;

	// Band 0
	sh[0] = 0.282095 * color;

	// Band 1
	sh[1] = 0.488603 * x * color;
	sh[2] = 0.488603 * z * color;
	sh[3] = 0.488603 * y * color;

	// Band 2
	sh[4] = 0.546274 * (x2 - y2) * color;
	sh[5] = 1.092548 * x * z * color;
	sh[6] = 0.315392 * (3.0 * z2 - 1.0) * color;
	sh[7] = 1.092548 * y * z * color;
	sh[8] = 1.092548 * x * y * color;
/*
	// Band 3
	sh[9] = 0.590044 * (x * (x2 - 3.0 * y2)) * color;
	sh[10] = 2.8906114 * 0.5 * z * (x2 - y2) * color;
	sh[11] = 0.457046 * x * (5.0*z2 - 1.0) * color;
	sh[12] = 0.373176 * (5.0*z3 - 3.0*z) * color;
	sh[13] = 0.457046 * y * (5.0*z2 - 1.0) * color;
	sh[14] = 2.8906114 * x*y*z * color;
	sh[15] =0.590043 * y * (3.0*x2 - y2) * color;

	// Band 4
	sh[16] = 3.0*sqrt(35.0/PI)/16.0 * (x2*(x2 - 3.0*y2) - y2*(3*x2-y2)) * color;
	sh[17] = 0.75*sqrt(0.5*35.0/PI) * x * (x2 - 3.0*y2) * z * color;
	sh[18] = 3.0*sqrt(5.0/PI)/8.0 * (x2 - y2) * (7.0*z2 - 1.0) * color;
	sh[19] = 0.75*sqrt(2.5/PI) * x * (7.0*z3 - 3.0*z) * color;
	sh[20] = 3.0*sqrt(1.0/PI)/16.0 * (35.0*z4 - 30.0*z2 + 3.0) * color;
	sh[21] = 0.75*sqrt(2.5/PI) * y * (7.0*z3 - 3.0*z) * color;
	sh[22] = 0.75*sqrt(5.0/PI) * x * y * (7.0*z2 - 1.0) * color;
	sh[23] = 0.75*sqrt(0.5*35.0/PI) * y * (3.0*x2 - y2) * z * color;
	sh[24] = 0.75*sqrt(35.0/PI) * x*y*(x2-y2) * color;*/
}

// https://www.rorydriscoll.com/2012/01/15/cubemap-texel-solid-angle/
float AreaElement(float x, float y)
{
	return atan(x * y, sqrt(x * x + y * y + 1));
}
float TexelCoordSolidAngle(int a_U, int a_V, int a_Size)
{
	// scale up to [-1, 1] range (inclusive), offset by 0.5 to point to texel
	// center.
	float U = (2.0 * (float(a_U) + 0.5) / float(a_Size)) - 1.0;
	float V = (2.0 * (float(a_V) + 0.5) / float(a_Size)) - 1.0;

	float InvResolution = 1.0 / a_Size;

	// U and V are the -1..1 texture coordinate on the current face.
	// Get projected area for this texel
	float x0         = U - InvResolution;
	float y0         = V - InvResolution;
	float x1         = U + InvResolution;
	float y1         = V + InvResolution;
	float SolidAngle = AreaElement(x0, y0) - AreaElement(x0, y1)
	                   - AreaElement(x1, y0) + AreaElement(x1, y1);

	return SolidAngle;
}

shared vec3 tmp[9];

void main()
{
	ivec3 pixel_coords = ivec3(gl_GlobalInvocationID.xyz);

	ivec3 local_coords = ivec3(gl_LocalInvocationID.xyz);

	if(local_coords == ivec3(0))
	{
		for(int i = 0; i < 9; ++i)
		{
			tmp[i] = vec3(0.0);
		}
	}
	barrier();

	vec3 normal
	    = computeDirectionFromTexel(pixel_coords, imageSize(environmentMap).x);

	vec3 color = imageLoad(environmentMap, pixel_coords).rgb;

	vec3 localSH[9];
	ProjectOntoSH(normal, color, localSH);

	float solidAngle = TexelCoordSolidAngle(pixel_coords.x, pixel_coords.y,
	                                        imageSize(environmentMap).x);
	for(int i = 0; i < 9; ++i)
	{
		atomicAdd(tmp[i].x, localSH[i].x * solidAngle);
		atomicAdd(tmp[i].y, localSH[i].y * solidAngle);
		atomicAdd(tmp[i].z, localSH[i].z * solidAngle);
	}

	barrier();

	if(local_coords == ivec3(0))
	{
		for(int i = 0; i < 9; ++i)
		{
			atomicAdd(shCoeffs[i].x, tmp[i].x);
			atomicAdd(shCoeffs[i].y, tmp[i].y);
			atomicAdd(shCoeffs[i].z, tmp[i].z);
		}
	}
}
